# Get a free key at https://aistudio.google.com/apikey  (never commit the real key)
GEMINI_API_KEY=
# Optional: override the model (default: gemini-flash-lite-latest)
GEMINI_MODEL=
# Video scan model: mock (default, demo analysis on the device) | server (POST /api/scan forwards to ML_API_URL) | browser
NEXT_PUBLIC_VIDEO_MODE=mock
# Server mode only: public URL of the ML service (POST {ML_API_URL}/analyze). Unset or failing falls back to the demo analysis.
ML_API_URL=
